-- Ejecutar DESPUÉS de desplegar notification-dispatch y guardar secretos en Vault.
-- Reutiliza project_url, publishable_key y uw_cron_secret.
select cron.schedule(
  'urban-warriors-notification-dispatch',
  '*/10 * * * *',
  $$
  select net.http_post(
    url := (select decrypted_secret from vault.decrypted_secrets where name='project_url') || '/functions/v1/notification-dispatch',
    headers := jsonb_build_object(
      'content-type','application/json',
      'apikey',(select decrypted_secret from vault.decrypted_secrets where name='publishable_key'),
      'x-uw-cron-secret',(select decrypted_secret from vault.decrypted_secrets where name='uw_cron_secret')
    ),
    body := '{}'::jsonb,
    timeout_milliseconds := 60000
  );
  $$
);
